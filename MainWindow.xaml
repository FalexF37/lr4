<Window x:Class="RandomStringNumbers.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Анализ массива LINQ и PLINQ" Height="750" Width="950"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Панель управления -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Количество элементов (N):" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="TxtCount" Text="100000" Width="100" VerticalAlignment="Center"/>

            <!-- Кнопка 1: Только генерация -->
            <Button x:Name="BtnGenerate" Content="1. Сгенерировать массив" Click="BtnGenerate_Click" 
                    Margin="10,0,0,0" Padding="10,5" FontWeight="Bold"/>

            <!-- Кнопка 2: Только анализ -->
            <Button x:Name="BtnProcess" Content="2. Выполнить анализ" Click="BtnProcess_Click" 
                    Margin="10,0,0,0" Padding="10,5" IsEnabled="False"/>

            <TextBlock x:Name="TxtStatus" VerticalAlignment="Center" Margin="20,0,0,0" Foreground="Gray" FontWeight="Bold"/>
        </StackPanel>

        <!-- Вкладки с результатами -->
        <TabControl Grid.Row="1">
            <!-- Вкладка исходного массива -->
            <TabItem Header="Исходный массив">
                <DockPanel>
                    <TextBlock x:Name="TxtSourceInfo" DockPanel.Dock="Top" Margin="5" FontWeight="Bold" Foreground="DarkSlateGray"/>
                    <ListBox x:Name="LstSource" FontFamily="Consolas"/>
                </DockPanel>
            </TabItem>

            <TabItem Header="1. Четные">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <GroupBox Header="LINQ" Grid.Column="0" Margin="5">
                        <DockPanel>
                            <TextBlock x:Name="TxtTime1Linq" DockPanel.Dock="Top" FontWeight="Bold" Foreground="DarkBlue" Margin="5"/>
                            <ListBox x:Name="Lst1Linq" FontFamily="Consolas"/>
                        </DockPanel>
                    </GroupBox>
                    <GroupBox Header="PLINQ" Grid.Column="1" Margin="5">
                        <DockPanel>
                            <TextBlock x:Name="TxtTime1Plinq" DockPanel.Dock="Top" FontWeight="Bold" Foreground="DarkGreen" Margin="5"/>
                            <ListBox x:Name="Lst1Plinq" FontFamily="Consolas"/>
                        </DockPanel>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="2. Нечетные">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <GroupBox Header="LINQ" Grid.Column="0" Margin="5">
                        <DockPanel>
                            <TextBlock x:Name="TxtTime2Linq" DockPanel.Dock="Top" FontWeight="Bold" Foreground="DarkBlue" Margin="5"/>
                            <ListBox x:Name="Lst2Linq" FontFamily="Consolas"/>
                        </DockPanel>
                    </GroupBox>
                    <GroupBox Header="PLINQ" Grid.Column="1" Margin="5">
                        <DockPanel>
                            <TextBlock x:Name="TxtTime2Plinq" DockPanel.Dock="Top" FontWeight="Bold" Foreground="DarkGreen" Margin="5"/>
                            <ListBox x:Name="Lst2Plinq" FontFamily="Consolas"/>
                        </DockPanel>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="3. Сумма 2-й и предпоследней = 6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <GroupBox Header="LINQ" Grid.Column="0" Margin="5">
                        <DockPanel>
                            <TextBlock x:Name="TxtTime3Linq" DockPanel.Dock="Top" FontWeight="Bold" Foreground="DarkBlue" Margin="5"/>
                            <ListBox x:Name="Lst3Linq" FontFamily="Consolas"/>
                        </DockPanel>
                    </GroupBox>
                    <GroupBox Header="PLINQ" Grid.Column="1" Margin="5">
                        <DockPanel>
                            <TextBlock x:Name="TxtTime3Plinq" DockPanel.Dock="Top" FontWeight="Bold" Foreground="DarkGreen" Margin="5"/>
                            <ListBox x:Name="Lst3Plinq" FontFamily="Consolas"/>
                        </DockPanel>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="4. Сумма всех цифр = 13">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <GroupBox Header="LINQ" Grid.Column="0" Margin="5">
                        <DockPanel>
                            <TextBlock x:Name="TxtTime4Linq" DockPanel.Dock="Top" FontWeight="Bold" Foreground="DarkBlue" Margin="5"/>
                            <ListBox x:Name="Lst4Linq" FontFamily="Consolas"/>
                        </DockPanel>
                    </GroupBox>
                    <GroupBox Header="PLINQ" Grid.Column="1" Margin="5">
                        <DockPanel>
                            <TextBlock x:Name="TxtTime4Plinq" DockPanel.Dock="Top" FontWeight="Bold" Foreground="DarkGreen" Margin="5"/>
                            <ListBox x:Name="Lst4Plinq" FontFamily="Consolas"/>
                        </DockPanel>
                    </GroupBox>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>